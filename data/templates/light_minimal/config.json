{
    "name": "light_minimal",
    "description": "Clean light theme with minimal design",
    
    "layout": "default",
    "base_class": "bg-white text-gray-900",
    
    "colors": {
        "bg": "#ffffff",
        "bg_secondary": "#f8fafc",
        "text_primary": "gray-900",
        "text_secondary": "gray-600",
        "text_muted": "gray-400",
        "accent_primary": "indigo",
        "accent_secondary": "violet",
        "accent_tertiary": "rose",
        "success": "green",
        "warning": "amber",
        "error": "red"
    },
    
    "components": {
        "card": "bg-gray-50 border border-gray-200 rounded-xl shadow-sm",
        "card_hover": "hover:border-{color}-300 hover:shadow-md transition-all",
        "badge": "text-xs font-medium uppercase tracking-wider",
        "title_gradient": "text-transparent bg-clip-text bg-gradient-to-r from-indigo-600 to-violet-600",
        "blur_decoration": "rounded-full blur-3xl opacity-20",
        "table_header": "border-b-2 border-gray-200 bg-gray-50",
        "table_row": "border-b border-gray-100 hover:bg-gray-50 transition-colors"
    },
    
    "animations": {
        "slide_top": "",
        "slide_bottom": "",
        "slide_left": "",
        "slide_right": "",
        "pop": ""
    },
    
    "icons": {
        "prefix": "mdi:",
        "default": "cube-outline",
        "checkmark": "check-circle-outline",
        "warning": "alert-outline",
        "close": "close-circle",
        "flash": "lightning-bolt",
        "chevron": "chevron-right"
    },
    
    "defaults": {
        "category_visual": "Overview",
        "category_table": "Data",
        "category_formula": "Math",
        "category_cards": "Details",
        "category_timeline": "Roadmap"
    }
}
