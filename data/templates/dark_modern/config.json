{
    "name": "dark_modern",
    "description": "Dark theme with modern gradients and animations",
    
    "layout": "standard",
    "base_class": "p-0 bg-[#0a0a0a] text-gray-100 font-sans overflow-hidden",
    
    "colors": {
        "bg": "#0a0a0a",
        "bg_secondary": "#0f0f0f",
        "text_primary": "gray-100",
        "text_secondary": "gray-400",
        "text_muted": "gray-500",
        "accent_primary": "blue",
        "accent_secondary": "purple",
        "accent_tertiary": "pink",
        "success": "emerald",
        "warning": "yellow",
        "error": "red"
    },
    
    "components": {
        "card": "bg-white/5 border border-white/10 rounded-[2rem] backdrop-blur-xl",
        "card_hover": "hover:border-{color}-500/50 transition-all",
        "badge": "text-xs font-mono uppercase tracking-[0.2em]",
        "title_gradient": "text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-purple-500 to-pink-400",
        "blur_decoration": "rounded-full blur-[120px]",
        "table_header": "border-b border-white/10 bg-white/5",
        "table_row": "border-b border-white/5 hover:bg-white/5 transition-colors"
    },
    
    "animations": {
        "slide_top": "v-motion-slide-top",
        "slide_bottom": "v-motion-slide-bottom",
        "slide_left": "v-motion-slide-left",
        "slide_right": "v-motion-slide-right",
        "pop": "v-motion-pop"
    },
    
    "icons": {
        "prefix": "carbon:",
        "default": "cube",
        "checkmark": "checkmark-outline",
        "warning": "warning-alt",
        "close": "close-filled",
        "flash": "flash",
        "chevron": "chevron-right"
    },
    
    "defaults": {
        "category_visual": "Visual",
        "category_table": "Data",
        "category_formula": "Formula",
        "category_cards": "Content",
        "category_timeline": "Timeline"
    }
}